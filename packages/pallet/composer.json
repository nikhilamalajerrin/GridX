{
    "name": "gridx/pallet-api",
    "version": "0.0.2",
    "description": "Inventory & Warehouse Management Extension for GridX",
    "keywords": [
        "gridx",
        "gridx-extension",
        "inventory",
        "inventory management",
        "stock management",
        "ecommerce",
        "inventory management api",
        "inventory system"
    ],
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "GridX Pte Ltd.",
            "email": "hello@gridx.io"
        },
        {
            "name": "Ronald A. Richardson",
            "email": "ron@gridx.io"
        }
    ],
    "require": {
        "php": "^8.0",
        "gridx/core-api": "*",
        "gridx/fleetops-api": "*",
        "php-http/guzzle7-adapter": "^1.0",
        "psr/http-factory-implementation": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.34.1",
        "nunomaduro/collision": "^5.11.0|^6.4.0",
        "pestphp/pest": "^1.22.6",
        "phpstan/phpstan": "^1.10.38",
        "symfony/var-dumper": "^5.4.29"
    },
    "autoload": {
        "psr-4": {
            "GridX\\Pallet\\": "server/src/",
            "GridX\\Pallet\\Seeds\\": "server/seeds/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GridX\\Pallet\\Tests\\": "server/tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "GridX\\Pallet\\Providers\\PalletServiceProvider"
            ]
        },
        "gridx": {
            "sandbox-migrations": false
        }
    },
    "config": {
        "vendor-dir": "./server_vendor",
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "scripts": {
        "lint": "php-cs-fixer fix -v --dry-run",
        "lint:fix": "php-cs-fixer fix -v",
        "test:lint": "@lint",
        "test:types": "server_vendor/bin/phpstan analyse --ansi --memory-limit=0",
        "test:unit": "server_vendor/bin/pest --colors=always",
        "test": [
            "@test:lint",
            "@test:types",
            "@test:unit"
        ]
    }
}
