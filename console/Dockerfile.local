# ---- Build Stage (workspace: console + local packages) ----
# Build context must be the REPO ROOT (not ./console) so the local
# white-labeled packages/ are available and override the npm registry
# versions of the Fleetbase engines.
FROM node:22.22.0-alpine3.22 AS builder

WORKDIR /build

RUN mkdir -p ~/.pnpm
ENV PNPM_HOME=/root/.pnpm
ENV PATH=/root/.pnpm/bin:$PATH

ARG ENVIRONMENT=production
ARG DISABLE_GRIDX_ATTRIBUTION=false
ENV DISABLE_GRIDX_ATTRIBUTION=$DISABLE_GRIDX_ATTRIBUTION
ARG EXTENSIONS=
ENV EXTENSIONS=$EXTENSIONS

RUN npm install -g ember-cli pnpm
RUN apk update && apk add git openssh-client
RUN mkdir -p -m 0600 ~/.ssh && ssh-keyscan github.com >> ~/.ssh/known_hosts

# Local engine/addon sources (white-labeled, editable)
COPY packages/ember-core packages/ember-core
COPY packages/ember-ui packages/ember-ui
COPY packages/fleetops-data packages/fleetops-data
COPY packages/fleetops packages/fleetops
COPY packages/iam-engine packages/iam-engine

# Console app
COPY console console

# Single workspace root: console's own workspace file must not shadow ours,
# and the lockfile refers to registry versions so it cannot be frozen.
RUN rm -f console/pnpm-workspace.yaml console/pnpm-lock.yaml

# Workspace config: link local packages over the published versions
RUN printf '%s\n' \
    'packages:' \
    '  - console' \
    '  - packages/*' \
    'linkWorkspacePackages: deep' \
    'preferWorkspacePackages: true' \
    'publicHoistPattern:' \
    '  - "*ember-core*"' \
    '  - "*ember-ui*"' \
    '  - "*fleetops-data*"' \
    'overrides:' \
    '  "@fleetbase/ember-core": "workspace:*"' \
    '  "@fleetbase/ember-ui": "workspace:*"' \
    '  "@fleetbase/fleetops-data": "workspace:*"' \
    '  "@fleetbase/fleetops-engine": "workspace:*"' \
    '  "@fleetbase/iam-engine": "workspace:*"' \
    > pnpm-workspace.yaml

RUN pnpm install --no-frozen-lockfile

WORKDIR /build/console
RUN pnpm build --environment $ENVIRONMENT

# GridX monochrome theme: hue-based desaturation of all blue-family colors
RUN node /build/console/monochrome.js /build/console/dist

# ---- Serve Stage ----
FROM nginx:alpine
COPY --from=builder /build/console/dist /usr/share/nginx/html
EXPOSE 4200
COPY console/nginx.conf /etc/nginx/conf.d/default.conf
CMD ["nginx", "-g", "daemon off;"]
