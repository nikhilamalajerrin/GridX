# GridX API (key auto-minted into .env; create more in console → Developers)
GRIDX_API_HOST=http://localhost:8000
GRIDX_API_KEY=

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any tool-calling model on OpenRouter. Free options:
#   nvidia/nemotron-3-ultra-550b-a55b:free   (default — agent orchestration, 1M ctx)
#   nvidia/nemotron-3-super-120b-a12b:free
#   poolside/laguna-m.1:free
#   cohere/north-mini-code:free
AGENT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

HUMAN_IN_THE_LOOP=true
